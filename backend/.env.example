# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Tavily web search — https://app.tavily.com
TAVILY_API_KEY=

# Postgres connection string. Leave unset for local development: conversations
# then go to backend/checkpoints.sqlite instead. Hosts usually provide this.
DATABASE_URL=

# Comma-separated list of origins allowed to call this API. The deployed
# frontend's address must appear here or the browser will block every request.
# Defaults to http://localhost:3000.
ALLOWED_ORIGINS=
